# 로컬 실행용 예시. `cp .env.example .env` 후 값을 바꿔 쓴다.
DATABASE_URL=postgres://drive:drive@localhost:5432/drive
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=drive
S3_SECRET_KEY=drive-secret
S3_BUCKET_PRIMARY=drive-region-a
S3_BUCKET_REPLICA=drive-region-b
S3_BUCKET_COLD=drive-cold

# 32자 이상
JWT_SECRET=change-me-to-a-random-string-of-32-chars
# 32바이트 키를 base64로 인코딩한 값. 생성: openssl rand -base64 32
BLOCK_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

LONG_POLL_TIMEOUT_MS=60000
LONG_POLL_MAX_CONNECTIONS=10000
UPLOAD_SESSION_TTL_HOURS=24
DELETED_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=30
COLD_STORAGE_AFTER_DAYS=90
MAX_VERSIONS_PER_FILE=100
